package main

// AST command wrapper — forwards all params to the native C implementation
command use_play_sound(filepath, volume) {
    play_sound(filepath, volume);
    print("play_sound: done.");
}

func main() {
    print("=== play_sound demo ===");

    // Direct native C dispatch through CommandRegistry:
    play_sound("assets/click.wav", "80");

    // Via AST command wrapper:
    use_play_sound("assets/music.ogg", "100");

    print("=== done ===");
}
