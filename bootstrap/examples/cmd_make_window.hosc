// HOSC Bootstrap — Usage example for command: make_window
// Auto-generated by tools/add_command.sh
//
// Parameters (3):
//   arg 1: title
//   arg 2: width
//   arg 3: height
//
// Run:
//   ./build/bin/Debug/hosc-bootstrap run bootstrap/examples/cmd_make_window.hosc

package main

// AST command wrapper — forwards all params to the native C implementation
command use_make_window(title, width, height) {
    make_window(title, width, height);
    print("make_window: done.");
}

func main() {
    print("=== make_window demo ===");

    // Direct native C dispatch through CommandRegistry:
    make_window("My HOSC Window", "1280", "720");

    // Via AST command wrapper:
    use_make_window("Another Window", "800", "600");

    print("=== done ===");
}
