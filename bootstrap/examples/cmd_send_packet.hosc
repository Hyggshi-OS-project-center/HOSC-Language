package main

// AST command wrapper — forwards all params to the native C implementation
command use_send_packet(host, port, payload) {
    send_packet(host, port, payload);
    print("send_packet: done.");
}

func main() {
    print("=== send_packet demo ===");

    // Direct native C dispatch through CommandRegistry:
    send_packet("<host>", "<port>", "<payload>");

    // Via AST command wrapper:
    use_send_packet("<host>", "<port>", "<payload>");

    print("=== done ===");
}
