package main

func main() {
    window({
        title: "Hello, World Window", 
        width: 520,
        height: 360,
        resizable: true,
        fullscreen: false,
        minWidth: 420,
        minHeight: 280,
        center: true
    })

    win32_message_box("Hello, world from HOSC Framework")

    text(20, 20, "Hello, world from HOSC Framework")
    text(20, 48, "This window contains a tiny copy of itself:")

    loop()
}

