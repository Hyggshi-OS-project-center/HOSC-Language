package main

func main() {
    window({
        title: "Hello, World Window", 
        width: 520,
        height: 360,
        resizable: true,
        fullscreen: false,
        minWidth: 420,
        minHeight: 280,
        center: true
    })

    win32_message_box("Hello, world from HOSC Framework")

    text(20, 20, "Hello, world from HOSC Framework")
    text(20, 48, "This window contains a tiny copy of itself:")

    text(20, 88, "package main")
    text(20, 108, "")
    text(20, 128, "func main() {")
    text(40, 148, "window({ title: \"Hello, World Window\", ... })")
    text(40, 168, "win32_message_box(\"Hello, world from HOSC Framework\")")
    text(40, 188, "text(20, 20, \"Hello, world from HOSC Framework\")")
    text(40, 208, "text(20, 48, \"This window contains a tiny copy of itself:\")")
    text(40, 228, "text(20, 88, \"package main\")")
    text(40, 248, "...")
    text(20, 276, "}")

    loop()
}

