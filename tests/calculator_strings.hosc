package main

func add(a, b) {
    return a + b;
}

func subtract(a, b) {
    return a - b;
}

func multiply(a, b) {
    return a * b;
}

func divide(a, b) {
    if (b == 0) {
        return null;
    }
    return a / b;
}

func main() {
    var x = 10;
    var y = 5;
    const PI = 3.14159;

    print("Calculator Demo");
    print("x = " + x);
    print("x + y = " + add(x, y));
    print("x - y = " + subtract(x, y));
    print("x * y = " + multiply(x, y));
    print("x / y = " + divide(x, y));
    print("PI = " + PI);
}
